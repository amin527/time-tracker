{
  "name": "daybook",
  "productName": "Daybook",
  "version": "1.0.0",
  "description": "Daybook time blocks and stopwatches, as a Windows desktop app",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron desktop/make-icon.js",
    "dist": "set ELECTRON_RUN_AS_NODE=1&& electron desktop/build.js"
  },
  "build": {
    "appId": "com.daybook.app",
    "productName": "Daybook",
    "directories": {
      "output": "dist"
    },
    "electronVersion": "44.5.1",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "timeblocks.html",
      "fonts/**",
      "desktop/main.js",
      "desktop/preload.js",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daybook"
    },
    "portable": {
      "artifactName": "Daybook-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
